node_modules/
web/node_modules/
.pnp
.pnp.js

# Build / Next.js
web/.next/
web/out/
web/.turbo/
.next/
out/
dist/
build/

# Ambiente — NUNCA commitar senhas
.env
.env.local
.env.docker
.env.prod
.env.*.local
web/.env
web/.env.local
web/.env.docker
web/.env.prod
web/.env.local.bak*
web/prisma/.env.bak

# Manter o exemplo
!.env.example
!web/.env.example

# Prisma
web/prisma/generated/

# Python cache
__pycache__/
*.py[cod]
*.pyo

# OS
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.swo
*~

# IDEs
.vscode/
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.sublime-*
*.code-workspace

# Claude Code
.claude/

# Docker volumes
pgdata/
redis-data/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Testes
coverage/
.nyc_output/

# Backups
*.bak
*.bak.*
*.backup
web/src/components/layout/Sidebar.bak.tsx
web/src/components/layout/Sidebar.bak-icons.tsx
web/src/components/layout/Sidebar.tsx.bak*

# Media / uploads
media/
uploads/

