// DATABASE SCHEMA - WORDCONDOS
// Prisma Schema - PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// AUTENTICAÇÃO E USUÁRIOS
// ============================================

model User {
  id                String    @id @default(uuid())
  email             String    @unique
  password_hash     String
  nome              String
  cpf               String?   @unique
  telefone          String?
  foto_url          String?
  status            UserStatus @default(ATIVO)
  email_verified    Boolean   @default(false)
  mfa_enabled       Boolean   @default(false)
  mfa_secret        String?
  last_login        DateTime?
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt
  
  // Relações
  roles             UserRole[]
  refresh_tokens    RefreshToken[]
  audit_logs        AuditLog[]
  moradores         Morador[]
  
  @@index([email])
  @@index([cpf])
}

enum UserStatus {
  ATIVO
  INATIVO
  BLOQUEADO
  PENDENTE_APROVACAO
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  permissions Json     // Array de permissões
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  
  users       UserRole[]
}

model UserRole {
  id             String     @id @default(uuid())
  user_id        String
  role_id        String
  condominio_id  String?    // Opcional para roles globais
  created_at     DateTime   @default(now())
  
  user           User       @relation(fields: [user_id], references: [id], onDelete: Cascade)
  role           Role       @relation(fields: [role_id], references: [id], onDelete: Cascade)
  condominio     Condominio? @relation(fields: [condominio_id], references: [id], onDelete: Cascade)
  
  @@unique([user_id, role_id, condominio_id])
  @@index([user_id])
  @@index([role_id])
  @@index([condominio_id])
}

model RefreshToken {
  id         String   @id @default(uuid())
  user_id    String
  token      String   @unique
  expires_at DateTime
  created_at DateTime @default(now())
  
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  
  @@index([user_id])
  @@index([token])
}

// ============================================
// CONDOMÍNIOS
// ============================================

model Condominio {
  id                    String    @id @default(uuid())
  nome                  String
  razao_social          String?
  cnpj                  String?   @unique
  cep                   String
  logradouro            String
  numero                String
  complemento           String?
  bairro                String
  cidade                String
  estado                String
  telefone              String?
  email                 String?
  logo_url              String?
  status                CondominioStatus @default(ATIVO)
  valor_taxa_condominio Decimal   @db.Decimal(10, 2)
  dia_vencimento        Int       @default(10)
  numero_blocos         Int       @default(1)
  numero_apartamentos   Int
  created_at            DateTime  @default(now())
  updated_at            DateTime  @updatedAt

  // Relações
  blocos                Bloco[]
  user_roles            UserRole[]
  receitas              Receita[]
  despesas              Despesa[]
  comunicados           Comunicado[]
  documentos            Documento[]
  ocorrencias           Ocorrencia[]
  areas_comuns          AreaComum[]
  encomendas            Encomenda[]
  assembleia_convocacoes AssembleiaConvocacao[]
  bills_receive         BillReceive[]
  bills_pay             BillPay[]
  chamados              Chamado[]

  @@index([cnpj])
}

enum CondominioStatus {
  ATIVO
  INATIVO
  SUSPENSO
}

// ============================================
// BLOCOS E APARTAMENTOS
// ============================================

model Bloco {
  id                   String       @id @default(uuid())
  condominio_id        String
  nome                 String
  numero_apartamentos  Int
  numero_andares       Int
  created_at           DateTime     @default(now())
  updated_at           DateTime     @updatedAt
  
  condominio           Condominio   @relation(fields: [condominio_id], references: [id], onDelete: Cascade)
  apartamentos         Apartamento[]
  
  @@index([condominio_id])
}

model Apartamento {
  id              String              @id @default(uuid())
  bloco_id        String
  numero          String
  andar           Int
  metragem        Decimal?            @db.Decimal(10, 2)
  quartos         Int?
  banheiros       Int?
  vagas_garagem   Int                 @default(0)
  status          ApartamentoStatus   @default(OCUPADO)
  fracao_ideal    Decimal             @db.Decimal(5, 4) // % para cálculo
  observacoes     String?
  created_at      DateTime            @default(now())
  updated_at      DateTime            @updatedAt

  bloco           Bloco               @relation(fields: [bloco_id], references: [id], onDelete: Cascade)
  moradores       Morador[]
  receitas        Receita[]
  boletos         Boleto[]
  reservas        Reserva[]
  encomendas      Encomenda[]
  chamados        Chamado[]

  @@unique([bloco_id, numero])
  @@index([bloco_id])
  @@index([status])
}

enum ApartamentoStatus {
  OCUPADO
  VAZIO
  ALUGADO
  REFORMA
}

// ============================================
// MORADORES
// ============================================

model Morador {
  id               String        @id @default(uuid())
  user_id          String?       @unique
  apartamento_id   String
  nome             String
  cpf              String?       @unique
  rg               String?
  data_nascimento  DateTime?
  email            String?
  telefone         String?
  celular          String?
  tipo             TipoMorador
  status           MoradorStatus @default(ATIVO)
  foto_url         String?
  data_entrada     DateTime      @default(now())
  data_saida       DateTime?
  observacoes      String?
  created_at       DateTime      @default(now())
  updated_at       DateTime      @updatedAt
  
  apartamento      Apartamento   @relation(fields: [apartamento_id], references: [id], onDelete: Cascade)
  user             User?         @relation(fields: [user_id], references: [id], onDelete: SetNull)
  veiculos         Veiculo[]
  pets             Pet[]
  
  @@index([apartamento_id])
  @@index([cpf])
  @@index([user_id])
}

enum TipoMorador {
  PROPRIETARIO
  INQUILINO
  DEPENDENTE
}

enum MoradorStatus {
  ATIVO
  INATIVO
}

model Veiculo {
  id            String   @id @default(uuid())
  morador_id    String
  placa         String   @unique
  modelo        String
  marca         String
  cor           String
  vaga_garagem  String?
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
  
  morador       Morador  @relation(fields: [morador_id], references: [id], onDelete: Cascade)
  
  @@index([morador_id])
  @@index([placa])
}

model Pet {
  id          String   @id @default(uuid())
  morador_id  String
  nome        String
  tipo        TipoPet
  raca        String?
  porte       PortePet
  foto_url    String?
  observacoes String?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  
  morador     Morador  @relation(fields: [morador_id], references: [id], onDelete: Cascade)
  
  @@index([morador_id])
}

enum TipoPet {
  CAO
  GATO
  PASSARO
  OUTRO
}

enum PortePet {
  PEQUENO
  MEDIO
  GRANDE
}

// ============================================
// FINANCEIRO
// ============================================

model Receita {
  id                String         @id @default(uuid())
  condominio_id     String
  apartamento_id    String?
  tipo              TipoReceita
  descricao         String
  valor             Decimal        @db.Decimal(10, 2)
  data_vencimento   DateTime
  data_pagamento    DateTime?
  status            StatusFinanceiro @default(PENDENTE)
  forma_pagamento   String?
  comprovante_url   String?
  observacoes       String?
  created_at        DateTime       @default(now())
  updated_at        DateTime       @updatedAt

  condominio        Condominio     @relation(fields: [condominio_id], references: [id], onDelete: Cascade)
  apartamento       Apartamento?   @relation(fields: [apartamento_id], references: [id], onDelete: SetNull)

  @@index([condominio_id])
  @@index([apartamento_id])
  @@index([status])
  @@index([data_vencimento])
}

enum TipoReceita {
  TAXA_CONDOMINIO
  TAXA_EXTRA
  MULTA
  JUROS
  RESERVA
  ALUGUEL_AREA_COMUM
  OUTRO
}

model Despesa {
  id                String           @id @default(uuid())
  condominio_id     String
  categoria         CategoriaDespesa
  fornecedor        String
  descricao         String
  valor             Decimal          @db.Decimal(10, 2)
  data_vencimento   DateTime
  data_pagamento    DateTime?
  status            StatusFinanceiro @default(PENDENTE)
  forma_pagamento   String?
  comprovante_url   String?
  observacoes       String?
  created_at        DateTime         @default(now())
  updated_at        DateTime         @updatedAt

  condominio        Condominio       @relation(fields: [condominio_id], references: [id], onDelete: Cascade)

  @@index([condominio_id])
  @@index([status])
  @@index([data_vencimento])
  @@index([categoria])
}

enum CategoriaDespesa {
  AGUA
  LUZ
  GAS
  INTERNET
  TELEFONE
  ELEVADOR
  PISCINA
  JARDIM
  LIMPEZA
  SEGURANCA
  SEGURO
  MANUTENCAO
  SALARIO
  ENCARGOS
  MATERIAL
  SERVICO_TERCEIRIZADO
  OUTRO
}

enum StatusFinanceiro {
  PENDENTE
  PAGO
  ATRASADO
  CANCELADO
}

model Boleto {
  id                String           @id @default(uuid())
  apartamento_id    String
  referencia        String           // MM/YYYY
  valor             Decimal          @db.Decimal(10, 2)
  data_vencimento   DateTime
  data_pagamento    DateTime?
  codigo_barras     String
  linha_digitavel   String
  url_boleto        String
  status            StatusBoleto     @default(ABERTO)
  multa             Decimal?         @db.Decimal(10, 2)
  juros             Decimal?         @db.Decimal(10, 2)
  desconto          Decimal?         @db.Decimal(10, 2)
  valor_pago        Decimal?         @db.Decimal(10, 2)
  observacoes       String?
  created_at        DateTime         @default(now())
  updated_at        DateTime         @updatedAt

  apartamento       Apartamento      @relation(fields: [apartamento_id], references: [id], onDelete: Cascade)

  @@unique([apartamento_id, referencia])
  @@index([apartamento_id])
  @@index([status])
  @@index([data_vencimento])
}

// Novos modelos para o módulo de finanças
model BillReceive {
  id              String           @id @default(uuid())
  title           String
  description     String?
  amount          Decimal          @db.Decimal(10, 2)
  dueDate         DateTime
  receivedDate    DateTime?
  status          StatusBill       @default(PENDING)
  condominiumId   String
  unitId          String?
  receivedBy      String?
  paymentMethod   String?
  documentNumber  String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  condominium     Condominio       @relation(fields: [condominiumId], references: [id], onDelete: Cascade)

  @@index([condominiumId])
  @@index([status])
  @@index([dueDate])
}

model BillPay {
  id            String           @id @default(uuid())
  title         String
  description   String?
  amount        Decimal          @db.Decimal(10, 2)
  dueDate       DateTime
  paidDate      DateTime?
  status        StatusBill       @default(PENDING)
  condominiumId String
  supplierId    String?
  paidBy        String?
  paymentMethod String?
  documentNumber String?
  category      String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  condominium   Condominio       @relation(fields: [condominiumId], references: [id], onDelete: Cascade)

  @@index([condominiumId])
  @@index([status])
  @@index([dueDate])
}

enum StatusBill {
  PENDING
  RECEIVED
  PAID
  OVERDUE
  CANCELLED
}

enum StatusBoleto {
  ABERTO
  PAGO
  VENCIDO
  CANCELADO
}

// ============================================
// COMUNICADOS
// ============================================

model Comunicado {
  id             String              @id @default(uuid())
  condominio_id  String
  titulo         String
  conteudo       String              @db.Text
  tipo           TipoComunicado
  prioridade     PriorridadeComunicado @default(NORMAL)
  fixado         Boolean             @default(false)
  anexos         String[]            // Array de URLs
  autor_id       String
  data_publicacao DateTime           @default(now())
  created_at     DateTime            @default(now())
  updated_at     DateTime            @updatedAt
  
  condominio     Condominio          @relation(fields: [condominio_id], references: [id], onDelete: Cascade)
  leituras       ComunicadoLeitura[]
  
  @@index([condominio_id])
  @@index([data_publicacao])
}

enum TipoComunicado {
  AVISO_GERAL
  MANUTENCAO
  ASSEMBLEIA
  EVENTO
  SEGURANCA
  REGRA
}

enum PriorridadeComunicado {
  BAIXA
  NORMAL
  ALTA
  URGENTE
}

model ComunicadoLeitura {
  id             String     @id @default(uuid())
  comunicado_id  String
  user_id        String
  lido_em        DateTime   @default(now())
  
  comunicado     Comunicado @relation(fields: [comunicado_id], references: [id], onDelete: Cascade)
  
  @@unique([comunicado_id, user_id])
  @@index([comunicado_id])
  @@index([user_id])
}

// ============================================
// DOCUMENTOS
// ============================================

model Documento {
  id             String            @id @default(uuid())
  condominio_id  String
  nome           String
  descricao      String?
  categoria      CategoriaDocumento
  arquivo_url    String
  tamanho        Int               // bytes
  tipo_arquivo   String
  visibilidade   VisibilidadeDocumento @default(TODOS)
  autor_id       String
  created_at     DateTime          @default(now())
  updated_at     DateTime          @updatedAt
  
  condominio     Condominio        @relation(fields: [condominio_id], references: [id], onDelete: Cascade)
  
  @@index([condominio_id])
  @@index([categoria])
}

enum CategoriaDocumento {
  ATA_ASSEMBLEIA
  CONVENCAO
  REGIMENTO_INTERNO
  CONTRATO
  APOLICE_SEGURO
  FISCAL
  PROJETO_PLANTA
  MANUAL_EQUIPAMENTO
  OUTRO
}

enum VisibilidadeDocumento {
  ADMINISTRACAO
  CONSELHO
  TODOS
}

// ============================================
// OCORRÊNCIAS
// ============================================

model Ocorrencia {
  id             String            @id @default(uuid())
  condominio_id  String
  tipo           TipoOcorrencia
  titulo         String
  descricao      String            @db.Text
  status         StatusOcorrencia  @default(ABERTA)
  prioridade     PrioridadeOcorrencia @default(MEDIA)
  local          String?
  anexos         String[]          // URLs de fotos
  autor_id       String
  responsavel_id String?
  data_abertura  DateTime          @default(now())
  data_resolucao DateTime?
  created_at     DateTime          @default(now())
  updated_at     DateTime          @updatedAt
  
  condominio     Condominio        @relation(fields: [condominio_id], references: [id], onDelete: Cascade)
  comentarios    OcorrenciaComentario[]
  
  @@index([condominio_id])
  @@index([status])
  @@index([data_abertura])
}

enum TipoOcorrencia {
  MANUTENCAO
  SEGURANCA
  LIMPEZA
  VIZINHANCA
  ELEVADOR
  PISCINA
  BARULHO
  OUTRO
}

enum StatusOcorrencia {
  ABERTA
  EM_ANDAMENTO
  RESOLVIDA
  CANCELADA
}

enum PrioridadeOcorrencia {
  BAIXA
  MEDIA
  ALTA
  URGENTE
}

model OcorrenciaComentario {
  id             String      @id @default(uuid())
  ocorrencia_id  String
  autor_id       String
  comentario     String      @db.Text
  created_at     DateTime    @default(now())

  ocorrencia     Ocorrencia  @relation(fields: [ocorrencia_id], references: [id], onDelete: Cascade)

  @@index([ocorrencia_id])
}

// ============================================
// CHAMADOS (TICKETS) - MÓDULO DE MANUTENÇÃO E SERVIÇOS
// ============================================

model Chamado {
  id               String            @id @default(uuid())
  condominio_id    String
  apartamento_id   String?
  tipo             TipoChamado
  categoria        CategoriaChamado
  titulo           String
  descricao        String            @db.Text
  status           StatusChamado     @default(ABERTO)
  prioridade       PrioridadeChamado @default(MEDIA)
  local_afetado    String?           // Local específico do problema
  fotos            String[]          // URLs de fotos
  autor_id         String
  responsavel_id   String?           // Usuário responsável pela resolução
  fornecedor_id    String?           // Fornecedor terceirizado (opcional)
  data_abertura    DateTime          @default(now())
  data_previsao    DateTime?         // Previsão de resolução
  data_resolucao   DateTime?
  solucao          String?           @db.Text  // Descrição da solução aplicada
  custo            Decimal?          @db.Decimal(10, 2)  // Custo do chamado
  observacoes      String?
  created_at       DateTime          @default(now())
  updated_at       DateTime          @updatedAt

  condominio       Condominio        @relation(fields: [condominio_id], references: [id], onDelete: Cascade)
  apartamento      Apartamento?      @relation(fields: [apartamento_id], references: [id], onDelete: SetNull)
  itens            ChamadoItem[]
  historico        ChamadoHistorico[]

  @@index([condominio_id])
  @@index([apartamento_id])
  @@index([status])
  @@index([tipo])
  @@index([data_abertura])
}

enum TipoChamado {
  MANUTENCAO_PREVENTIVA
  MANUTENCAO_CORRETIVA
  SOLICITACAO_SERVICO
  RECLAMACAO
  SUGESTAO
  EMERGENCIA
}

enum CategoriaChamado {
  ELETRICA
  HIDRAULICA
  ELEVADOR
  AR_CONDICIONADO
  PISCINA
  JARDIM
  LIMPEZA
  SEGURANCA
  ESTRUTURAL
  ELETRONICA
  TELEFONIA
  INTERNET
  GAS
  INCENDIO
  OUTRO
}

enum StatusChamado {
  ABERTO
  EM_ANALISE
  APROVADO
  AGUARDANDO_PECAS
  EM_ANDAMENTO
  CONCLUIDO
  CANCELADO
}

enum PrioridadeChamado {
  BAIXA
  MEDIA
  ALTA
  URGENTE
  EMERGENCIA
}

model ChamadoItem {
  id              String        @id @default(uuid())
  chamado_id      String
  descricao       String
  quantidade      Int           @default(1)
  valor_unitario  Decimal?      @db.Decimal(10, 2)
  valor_total     Decimal?      @db.Decimal(10, 2)
  tipo            TipoItemChamado @default(SERVICO)
  observacoes     String?
  created_at      DateTime      @default(now())
  updated_at      DateTime      @updatedAt

  chamado         Chamado       @relation(fields: [chamado_id], references: [id], onDelete: Cascade)

  @@index([chamado_id])
}

enum TipoItemChamado {
  SERVICO
  MATERIAL
  PECAS
  OUTRO
}

model ChamadoHistorico {
  id              String            @id @default(uuid())
  chamado_id      String
  usuario_id      String
  acao            TipoAcaoChamado
  descricao       String            @db.Text
  status_anterior String?
  status_novo     String?
  valor_anterior  Decimal?          @db.Decimal(10, 2)
  valor_novo      Decimal?          @db.Decimal(10, 2)
  created_at      DateTime          @default(now())

  chamado         Chamado           @relation(fields: [chamado_id], references: [id], onDelete: Cascade)

  @@index([chamado_id])
  @@index([usuario_id])
}

enum TipoAcaoChamado {
  ABERTURA
  ALTERACAO_STATUS
  ALTERACAO_PRIORIDADE
  ATRIBUICAO_RESPONSAVEL
  ADICAO_ITEM
  REMOCAO_ITEM
  ALTERACAO_CUSTO
  CONCLUSAO
  CANCELAMENTO
  REABERTURA
  OBSERVACAO
}

// ============================================
// ÁREAS COMUNS E RESERVAS
// ============================================

model AreaComum {
  id              String     @id @default(uuid())
  condominio_id   String
  nome            String
  descricao       String?
  capacidade      Int?
  valor_reserva   Decimal?   @db.Decimal(10, 2)
  tempo_min_reserva Int      @default(120) // minutos
  tempo_max_reserva Int      @default(480) // minutos
  antecedencia_min Int       @default(48)  // horas
  antecedencia_max Int       @default(720) // horas
  requer_aprovacao Boolean   @default(false)
  ativo           Boolean    @default(true)
  regras          String?    @db.Text
  fotos           String[]
  created_at      DateTime   @default(now())
  updated_at      DateTime   @updatedAt
  
  condominio      Condominio @relation(fields: [condominio_id], references: [id], onDelete: Cascade)
  reservas        Reserva[]
  
  @@index([condominio_id])
}

model Reserva {
  id              String         @id @default(uuid())
  area_comum_id   String
  apartamento_id  String
  data_inicio     DateTime
  data_fim        DateTime
  status          StatusReserva  @default(PENDENTE)
  valor           Decimal?       @db.Decimal(10, 2)
  observacoes     String?
  motivo_rejeicao String?
  created_at      DateTime       @default(now())
  updated_at      DateTime       @updatedAt
  
  area_comum      AreaComum      @relation(fields: [area_comum_id], references: [id], onDelete: Cascade)
  apartamento     Apartamento    @relation(fields: [apartamento_id], references: [id], onDelete: Cascade)
  
  @@index([area_comum_id])
  @@index([apartamento_id])
  @@index([data_inicio])
}

enum StatusReserva {
  PENDENTE
  APROVADA
  REJEITADA
  CANCELADA
  CONCLUIDA
}

// ============================================
// ENCOMENDAS
// ============================================

model Encomenda {
  id              String          @id @default(uuid())
  condominio_id   String
  apartamento_id  String
  tipo            TipoEncomenda
  remetente       String
  descricao       String?
  data_recebimento DateTime       @default(now())
  data_retirada   DateTime?
  retirado_por    String?
  observacoes     String?
  created_at      DateTime        @default(now())
  updated_at      DateTime        @updatedAt
  
  condominio      Condominio      @relation(fields: [condominio_id], references: [id], onDelete: Cascade)
  apartamento     Apartamento     @relation(fields: [apartamento_id], references: [id], onDelete: Cascade)
  
  @@index([condominio_id])
  @@index([apartamento_id])
  @@index([data_recebimento])
}

enum TipoEncomenda {
  CORREIOS
  SEDEX
  TRANSPORTADORA
  ENTREGADOR
  OUTRO
}

// ============================================
// ASSEMBLEIA
// ============================================

model AssembleiaConvocacao {
  id              String              @id @default(uuid())
  condominio_id   String
  tipo            TipoAssembleia
  titulo          String
  descricao       String              @db.Text
  data_assembleia DateTime
  local           String
  pauta           String              @db.Text
  quorum_minimo   Int                 @default(50) // %
  status          StatusAssembleia    @default(CONVOCADA)
  ata_url         String?
  created_at      DateTime            @default(now())
  updated_at      DateTime            @updatedAt
  
  condominio      Condominio          @relation(fields: [condominio_id], references: [id], onDelete: Cascade)
  votacoes        AssembleiaVotacao[]
  
  @@index([condominio_id])
  @@index([data_assembleia])
}

enum TipoAssembleia {
  ORDINARIA
  EXTRAORDINARIA
}

enum StatusAssembleia {
  CONVOCADA
  EM_ANDAMENTO
  CONCLUIDA
  CANCELADA
}

model AssembleiaVotacao {
  id             String               @id @default(uuid())
  assembleia_id  String
  titulo         String
  descricao      String               @db.Text
  tipo_votacao   TipoVotacao
  opcoes         Json                 // Array de opções
  data_inicio    DateTime
  data_fim       DateTime
  resultado      Json?                // Resultado da votação
  created_at     DateTime             @default(now())
  updated_at     DateTime             @updatedAt
  
  assembleia     AssembleiaConvocacao @relation(fields: [assembleia_id], references: [id], onDelete: Cascade)
  votos          Voto[]
  
  @@index([assembleia_id])
}

enum TipoVotacao {
  SIMPLES         // Sim/Não
  MULTIPLA_ESCOLHA
  CLASSIFICACAO
}

model Voto {
  id         String            @id @default(uuid())
  votacao_id String
  user_id    String
  voto       Json              // Valor do voto
  created_at DateTime          @default(now())
  
  votacao    AssembleiaVotacao @relation(fields: [votacao_id], references: [id], onDelete: Cascade)
  
  @@unique([votacao_id, user_id])
  @@index([votacao_id])
}

// ============================================
// AUDITORIA
// ============================================

model AuditLog {
  id           String   @id @default(uuid())
  user_id      String?
  action       String
  resource     String
  resource_id  String?
  ip_address   String
  user_agent   String?
  changes      Json?    // Before/After
  created_at   DateTime @default(now())
  
  user         User?    @relation(fields: [user_id], references: [id], onDelete: SetNull)
  
  @@index([user_id])
  @@index([resource])
  @@index([created_at])
}

// ============================================
// CONFIGURAÇÕES
// ============================================

model SystemConfig {
  id         String   @id @default(uuid())
  key        String   @unique
  value      Json
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  
  @@index([key])
}
