generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL") // será injetada pelo provision/seed
}

enum Role {
  ADMIN
  USER
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(ADMIN)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Condominium {
  id        String   @id @default(uuid())
  name      String
  cnpj      String?
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// --- Cadastros de condomínio ---
model Unit {
  id           String     @id @default(uuid())
  tenant       String     @default("parkclub")
  block        String
  number       String
  areaM2       Decimal?   @db.Decimal(10, 2)
  bedrooms     Int?       @default(0)
  parkingSpots Int?       @default(0)
  notes        String?    @db.Text
  residents    Resident[]
  vehicles     Vehicle[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([tenant, block, number])
  @@index([tenant, block])
}

model Resident {
  id        String       @id @default(uuid())
  tenant    String       @default("parkclub")
  unitId    String
  unit      Unit         @relation(fields: [unitId], references: [id], onDelete: Cascade)
  name      String
  email     String?
  phone     String?
  cpf       String?
  role      ResidentRole @default(MORADOR)
  isOwner   Boolean      @default(false)
  birthDate DateTime?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([tenant, cpf])
  @@index([tenant, unitId])
}

model Vehicle {
  id        String   @id @default(uuid())
  tenant    String   @default("parkclub")
  unitId    String
  unit      Unit     @relation(fields: [unitId], references: [id], onDelete: Cascade)
  plate     String
  model     String?
  color     String?
  tag       String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenant, plate])
  @@index([tenant, unitId])
}

enum ResidentRole {
  MORADOR
  PROPRIETARIO
  INQUILINO
  SINDICO
}
