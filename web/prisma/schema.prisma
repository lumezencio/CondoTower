generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL") // será injetada pelo provision/seed
}

enum Role {
  ADMIN
  USER
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(ADMIN)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Condominium {
  id        String   @id @default(uuid())
  name      String
  cnpj      String?
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// --- Cadastros de condomínio ---
model Unit {
  id           String     @id @default(uuid())
  tenant       String     @default("parkclub")
  block        String
  number       String
  areaM2       Decimal?   @db.Decimal(10, 2)
  bedrooms     Int?       @default(0)
  parkingSpots Int?       @default(0)
  notes        String?    @db.Text

  owners       Owner[]
  residents    Resident[]
  vehicles     Vehicle[]
  pets         Pet[]
  expenses     Expense[]
  revenues     Revenue[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([tenant, block, number])
  @@index([tenant, block])
}

// Despesas do condomínio
model Expense {
  id              String      @id @default(uuid())
  tenant          String      @default("parkclub")
  unitId          String?
  unit            Unit?       @relation(fields: [unitId], references: [id], onDelete: SetNull)
  description     String
  category        ExpenseCategory
  amount          Decimal     @db.Decimal(10, 2)
  dueDate         DateTime
  paymentDate     DateTime?
  status          PaymentStatus @default(PENDING)
  paymentMethod   String?
  receiptUrl      String?
  notes           String?     @db.Text
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([tenant, dueDate])
  @@index([tenant, status])
  @@index([tenant, category])
}

// Receitas do condomínio
model Revenue {
  id              String      @id @default(uuid())
  tenant          String      @default("parkclub")
  unitId          String?
  unit            Unit?       @relation(fields: [unitId], references: [id], onDelete: SetNull)
  description     String
  type            RevenueType
  amount          Decimal     @db.Decimal(10, 2)
  dueDate         DateTime
  receiptDate     DateTime?
  status          PaymentStatus @default(PENDING)
  paymentMethod   String?
  receiptUrl      String?
  notes           String?     @db.Text
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([tenant, dueDate])
  @@index([tenant, status])
  @@index([tenant, type])
}

enum ExpenseCategory {
  AGUA
  LUZ
  GAS
  INTERNET
  TELEFONE
  ELEVADOR
  PISCINA
  JARDIM
  LIMPEZA
  SEGURANCA
  SEGURO
  MANUTENCAO
  SALARIO
  ENCARGOS
  MATERIAL
  SERVICO_TERCEIRIZADO
  TAXA_COND
  TAXA_EXTRA
  MULTA
  OUTRO
}

enum RevenueType {
  TAXA_COND
  TAXA_EXTRA
  MULTA
  JUROS
  RESERVA
  ALUGUEL_AREA_COMUM
  OUTRO
}

enum PaymentStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED
}

// Impostos retidos nas receitas
model TaxWithholding {
  id              String      @id @default(uuid())
  tenant          String      @default("parkclub")
  revenueId       String
  revenue         Revenue     @relation(fields: [revenueId], references: [id], onDelete: Cascade)
  taxType         TaxType
  baseAmount      Decimal     @db.Decimal(10, 2)  // Valor base para cálculo do imposto
  taxRate         Decimal     @db.Decimal(5, 4)   // Alíquota (ex: 0.05 para 5%)
  taxAmount       Decimal     @db.Decimal(10, 2)  // Valor do imposto retido
  dueDate         DateTime    // Data de vencimento da guia
  paymentDate     DateTime?   // Data de pagamento
  status          PaymentStatus @default(PENDING)
  guideUrl        String?     // URL da guia de pagamento
  notes           String?     @db.Text
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([tenant, revenueId])
  @@index([tenant, dueDate])
  @@index([tenant, status])
}

enum TaxType {
  COFINS
  CSLL
  IRPJ
  PIS
  ISS
  OUTRO
}

// Proprietarios e Inquilinos (dados completos, vinculados a unidade)
model Owner {
  id            String    @id @default(uuid())
  tenant        String    @default("parkclub")
  unitId        String
  unit          Unit      @relation(fields: [unitId], references: [id], onDelete: Cascade)
  type          OwnerType

  // Dados pessoais completos
  name          String
  cpf           String
  rg            String?
  phone         String?
  phone2        String?
  email         String?
  birthDate     DateTime?
  profession    String?

  // Endereco de cobranca (pode ser diferente da unidade)
  billingStreet       String?
  billingNumber       String?
  billingComplement   String?
  billingNeighborhood String?
  billingCity         String?
  billingState        String?
  billingZip          String?

  // Contrato (para inquilino)
  contractStart DateTime?
  contractEnd   DateTime?
  rentValue     Decimal?  @db.Decimal(10, 2)

  notes         String?   @db.Text
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([tenant, cpf])
  @@unique([tenant, unitId, type])
  @@index([tenant, unitId])
}

enum OwnerType {
  PROPRIETARIO
  INQUILINO
}

model Resident {
  id        String       @id @default(uuid())
  tenant    String       @default("parkclub")
  unitId    String
  unit      Unit         @relation(fields: [unitId], references: [id], onDelete: Cascade)
  name      String
  email     String?
  phone     String?
  cpf       String?
  role      ResidentRole @default(MORADOR)
  isOwner   Boolean      @default(false)
  birthDate DateTime?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([tenant, cpf])
  @@index([tenant, unitId])
}

model Vehicle {
  id        String   @id @default(uuid())
  tenant    String   @default("parkclub")
  unitId    String
  unit      Unit     @relation(fields: [unitId], references: [id], onDelete: Cascade)
  plate     String
  brand     String?
  model     String?
  color     String?
  year      Int?
  tag       String?
  notes     String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenant, plate])
  @@index([tenant, unitId])
}

model Pet {
  id        String   @id @default(uuid())
  tenant    String   @default("parkclub")
  unitId    String
  unit      Unit     @relation(fields: [unitId], references: [id], onDelete: Cascade)
  name      String
  species   String   // CACHORRO, GATO, PASSARO, etc
  breed     String?
  color     String?
  size      String?  // PEQUENO, MEDIO, GRANDE
  birthDate DateTime?
  vaccinated Boolean @default(false)
  notes     String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenant, unitId])
}

enum ResidentRole {
  PROPRIETARIO
  INQUILINO
  FAMILIAR
  MORADOR
  SINDICO
}
